# Copy this file to keystore.properties. The real file and *.jks/*.keystore are ignored by Git.
KAFLUL_RELEASE_STORE_FILE=upload-keystore.jks
KAFLUL_RELEASE_STORE_PASSWORD=CHANGE_ME
KAFLUL_RELEASE_KEY_ALIAS=upload
KAFLUL_RELEASE_KEY_PASSWORD=CHANGE_ME

# Increment KAFLUL_VERSION_CODE for every Play Console upload.
KAFLUL_VERSION_CODE=1
KAFLUL_VERSION_NAME=1.0
